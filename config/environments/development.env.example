NAIJACHASE_ENV=development
MYSQL_SSL_MODE=disabled
MYSQL_POOL_MIN=1
MYSQL_POOL_MAX=8
MYSQL_POOL_WAIT_TIMEOUT_MS=2000
MYSQL_CONNECT_TIMEOUT_MS=2000
MYSQL_READ_TIMEOUT_MS=10000
MYSQL_WRITE_TIMEOUT_MS=10000
NAIJACHASE_API_BIND=127.0.0.1:8080
NAIJACHASE_RATE_LIMIT_PER_MINUTE=120
NAIJACHASE_REQUEST_TIMEOUT_SECONDS=25
NAIJACHASE_MAX_CONCURRENT_REQUESTS=64
NAIJACHASE_EMAIL_WORKERS=1
RUST_LOG=debug,tower_http=info
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
NAIJACHASE_EMAIL_FROM=
NAIJACHASE_PUBLIC_WEB_URL=http://127.0.0.1:4173
NAIJACHASE_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
