# For production, run make admin-prepare-config after building the backend.
# It safely imports the existing game's .env connection settings, asks only for
# the web password, and generates private service credentials automatically.
# Existing prepared files are reused. See docs/admin-deployment.md.
# These are separate admin credentials; never source the player's .env.
ADMIN_ENVIRONMENT=development
ADMIN_BIND=127.0.0.1:8081
ADMIN_PUBLIC_ORIGIN=http://127.0.0.1:4174
ADMIN_BOOTSTRAP_USERNAME=admin
# This is a PHC hash of the temporary WEB LOGIN password, seeded only when the
# control store is empty. The setup helper hashes hidden input for you.
ADMIN_BOOTSTRAP_PASSWORD_HASH=''

ADMIN_MYSQL_HOST=127.0.0.1
ADMIN_MYSQL_PORT=3306
ADMIN_MYSQL_USER=naijachase_admin
# DATABASE service password, not the web login password. The helper generates
# and provisions the matching service user; no manual password copying needed.
ADMIN_MYSQL_PASSWORD=''
ADMIN_MYSQL_DATABASE=naijachase
# required = encryption, including self-signed/name-mismatched certificates,
# matching the game connection. verify_identity = also verify trust/hostname.
# Neither falls back to plaintext. disabled is rejected in production.
ADMIN_MYSQL_SSL_MODE=required
# Optional CA PEM used by verify_identity; required does not need a CA file.
# ADMIN_MYSQL_SSL_CA=/opt/naijachase-admin/shared/mysql-ca.pem

# Separate admin-owned schema for staff, sessions, audit and operational notes.
# HOST/PORT/SSL_MODE/SSL_CA inherit reporting values when omitted.
# USER/PASSWORD/DATABASE are mandatory, independent of reporting credentials.
ADMIN_CONTROL_MYSQL_USER=naijachase_admin_control
ADMIN_CONTROL_MYSQL_PASSWORD=''
ADMIN_CONTROL_MYSQL_DATABASE=naijachase_admin

# The disk and system readings describe this admin service host only.
ADMIN_DISK_PATH=/
# Optional fixed loopback probe of http://127.0.0.1:8080/health/ready.
# Leave false when the game API runs on a different machine.
ADMIN_GAME_HEALTH_ENABLED=false
# Optional absolute path readable by the service; absence shows Unconfigured.
# JSON format: {"last_success_at":"2026-10-20T00:00:00Z"}
# ADMIN_BACKUP_STATUS_PATH=/opt/naijachase-admin/shared/backup-status.json
ADMIN_BACKUP_MAX_AGE_HOURS=24
RUST_LOG=info,tower_http=warn

# Enable after the documented advertising launch review; drafts/previews work while off.
ADMIN_ADS_ENABLED=false

# Exact player origin allowed to submit anonymous ad measurements.
ADMIN_ADS_PLAYER_ORIGIN=https://naijachase.app
