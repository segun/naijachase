NAIJACHASE_ENV=staging
MYSQL_SSL_MODE=required
MYSQL_POOL_MIN=2
MYSQL_POOL_MAX=16
MYSQL_POOL_WAIT_TIMEOUT_MS=2000
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_READ_TIMEOUT_MS=15000
MYSQL_WRITE_TIMEOUT_MS=15000
NAIJACHASE_API_BIND=127.0.0.1:8080
NAIJACHASE_RATE_LIMIT_PER_MINUTE=60
NAIJACHASE_REQUEST_TIMEOUT_SECONDS=25
NAIJACHASE_MAX_CONCURRENT_REQUESTS=96
NAIJACHASE_EMAIL_WORKERS=2
RUST_LOG=info,tower_http=info
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
NAIJACHASE_EMAIL_FROM=
NAIJACHASE_PUBLIC_WEB_URL=
NAIJACHASE_ALLOWED_ORIGINS=
