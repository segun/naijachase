# Deployment-only: install as shared/migrations.env, readable only by the
# naijachase-migrate OS account. Never load this file into the API service.
MYSQL_HOST=
MYSQL_PORT=23306
MYSQL_USER=naijachase_migrate
MYSQL_PASSWORD=
MYSQL_DATABASE=naijachase
MYSQL_SSL_MODE=required
MYSQL_POOL_MIN=0
MYSQL_POOL_MAX=2
MYSQL_POOL_WAIT_TIMEOUT_MS=2000
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_READ_TIMEOUT_MS=240000
MYSQL_WRITE_TIMEOUT_MS=240000
