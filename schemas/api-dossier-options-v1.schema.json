{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naijachase.app/schemas/api-dossier-options-v1.schema.json",
  "title": "NaijaChase dossier options",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogue_version", "fields"],
  "properties": {
    "catalogue_version": { "const": 1 },
    "fields": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "label", "options"],
        "properties": {
          "field": {
            "enum": ["sex", "height", "skin_tone", "hair", "hobby", "vehicle", "accessory", "feature"]
          },
          "label": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      }
    }
  }
}
