    "state": {"type":"object","required":["mission_id","case_dossier","trail_status","dossier","suspect_files","resolved_thief_name","opening_budget","balance","transport_rules_version"],"properties":{"mission_id":{"type":"string"},"case_dossier":{"type":"object","required":["title","stolen_item","premise","opening_briefing"],"properties":{"title":{"type":"string"},"stolen_item":{"type":"string"},"premise":{"type":"string"},"opening_briefing":{"type":"string"}},"additionalProperties":false},"trail_status":{"enum":["hot","cold"]},"dossier":{"type":"object","additionalProperties":{"type":"string"}},"suspect_files":{"type":"array","maxItems":3,"items":{"type":"object","required":["suspect_id","name","alias","dossier","summary","portrait"],"properties":{"suspect_id":{"type":"string"},"name":{"type":"string"},"alias":{"type":"string"},"dossier":{"type":"object","additionalProperties":{"type":"string"}},"summary":{"type":"string"},"portrait":{"type":"object","required":["skin_color","hair_style","hair_color","background_color","presentation"],"properties":{"skin_color":{"type":"string"},"hair_style":{"type":"string"},"hair_color":{"type":"string"},"background_color":{"type":"string"},"presentation":{"type":"string"}},"additionalProperties":false}},"additionalProperties":false}},"resolved_thief_name":{"type":["string","null"]},"opening_budget":{"type":"integer","minimum":0},"balance":{"type":"integer","minimum":0},"transport_rules_version":{"type":"integer","minimum":1}}},
