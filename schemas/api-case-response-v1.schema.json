{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naijachase.example/schemas/api-case-response-v1",
  "title": "Naija Chase API case response v1",
  "type": "object",
  "required": ["api_version", "case_id", "state_version", "duplicate", "attempt_kind", "state", "events"],
  "properties": {
    "api_version": {"const": "v1"},
    "case_id": {"type": "string"},
    "state_version": {"type": "integer", "minimum": 1},
    "duplicate": {"type": "boolean"},
    "attempt_kind": {"enum": ["ordinary", "replay", "weekly"]},
    "state": {"type":"object","required":["mission_id","case_dossier","dossier","opening_budget","balance","transport_rules_version"],"properties":{"mission_id":{"type":"string"},"case_dossier":{"type":"object","required":["title","stolen_item","premise","opening_briefing"],"properties":{"title":{"type":"string"},"stolen_item":{"type":"string"},"premise":{"type":"string"},"opening_briefing":{"type":"string"}},"additionalProperties":false},"dossier":{"type":"object","additionalProperties":{"type":"string"}},"opening_budget":{"type":"integer","minimum":0},"balance":{"type":"integer","minimum":0},"transport_rules_version":{"type":"integer","minimum":1}}},
    "events": {"type": "array"}
  },
  "additionalProperties": false
}
