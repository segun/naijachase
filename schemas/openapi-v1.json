      ,"TokenLedgerEntry": {"type":"object","required":["amount","balance_after","reason","reference_id","created_at"],"properties":{"amount":{"type":"integer"},"balance_after":{"type":"integer"},"reason":{"enum":["case_completion","first_completion","achievement","witness_pressure"]},"reference_id":{"type":"string"},"created_at":{"type":"string"}}}
