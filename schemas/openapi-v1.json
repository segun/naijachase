      ,"PressureEvent": {"type":"object","required":["event_type","data"],"properties":{"event_type":{"type":"string"},"data":{"type":"object"}}}
      ,"DisciplinaryCase": {"type":"object","required":["disciplinary_case_id","offence","repeat_offender","votes","decision","punishment","points_before","points_after","old_rank","new_rank","acknowledged"],"properties":{"disciplinary_case_id":{"type":"string"},"offence":{"enum":["witness_tampering","excessive_use_of_force"]},"repeat_offender":{"type":"boolean"},"votes":{"type":"array","minItems":5,"maxItems":5,"items":{"enum":["warning","punish"]}},"decision":{"enum":["warning","punish"]},"punishment":{"enum":["none","points_deducted","demoted","jailed"]},"points_before":{"type":"integer"},"points_after":{"type":"integer"},"old_rank":{"type":"string"},"new_rank":{"type":"string"},"jailed_until":{"type":["string","null"]},"acknowledged":{"type":"boolean"}}}
      ,"PressureResult": {"type":"object","required":["command_id","state_version","method","detected","token_balance","events"],"properties":{"command_id":{"type":"string"},"state_version":{"type":"integer"},"method":{"enum":["bribe","intimidate"]},"extra_clue":{"type":["string","null"]},"offence":{"type":["string","null"]},"detected":{"type":"boolean"},"panel":{"oneOf":[{"$ref":"#/components/schemas/DisciplinaryCase"},{"type":"null"}]},"token_balance":{"type":"integer"},"events":{"type":"array","items":{"$ref":"#/components/schemas/PressureEvent"}}}}
