{
  "name": "naijachase-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build && node dev/check-budget.mjs",
    "test": "svelte-check --tsconfig ./tsconfig.json && node --test tests/*.test.mjs",
    "preview": "vite preview",
    "mock": "node dev/mock-api.mjs",
    "assets:optimize": "node dev/optimize-assets.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.29.0",
    "@babylonjs/loaders": "9.29.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "sharp": "^0.35.5",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
