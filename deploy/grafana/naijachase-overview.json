{
  "title": "NaijaChase production overview",
  "uid": "naijachase-overview",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"type":"timeseries","title":"Requests by route/status","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum by (route,status) (rate(naijachase_http_responses_total[5m]))","legendFormat":"{{route}} {{status}}"}]},
    {"type":"timeseries","title":"p95 request latency","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"histogram_quantile(0.95, sum by (le,route) (rate(naijachase_http_request_duration_seconds_bucket[5m])))","legendFormat":"{{route}}"}]},
    {"type":"timeseries","title":"Active and waiting work","gridPos":{"h":8,"w":8,"x":0,"y":8},"targets":[{"expr":"naijachase_http_active_requests","legendFormat":"active requests"},{"expr":"naijachase_runtime_waiting_tasks","legendFormat":"runtime waiting"}]},
    {"type":"timeseries","title":"MySQL pool","gridPos":{"h":8,"w":8,"x":8,"y":8},"targets":[{"expr":"naijachase_mysql_pool_waiters","legendFormat":"waiters"},{"expr":"rate(naijachase_mysql_pool_acquisition_failures_total[5m])","legendFormat":"failures/s"}]},
    {"type":"timeseries","title":"Email queue","gridPos":{"h":8,"w":8,"x":16,"y":8},"targets":[{"expr":"naijachase_email_queue_messages","legendFormat":"queued"},{"expr":"naijachase_email_oldest_pending_age_seconds","legendFormat":"oldest seconds"}]},
    {"type":"timeseries","title":"Weekly jobs","gridPos":{"h":8,"w":8,"x":0,"y":16},"targets":[{"expr":"increase(naijachase_weekly_jobs_total[10m])","legendFormat":"runs"},{"expr":"increase(naijachase_weekly_job_failures_total[10m])","legendFormat":"failures"}]},
    {"type":"timeseries","title":"Process CPU","gridPos":{"h":8,"w":8,"x":8,"y":16},"targets":[{"expr":"rate(process_cpu_seconds_total{job=\"naijachase-api\"}[5m])","legendFormat":"cores"}]},
    {"type":"timeseries","title":"Process memory","gridPos":{"h":8,"w":8,"x":16,"y":16},"targets":[{"expr":"process_resident_memory_bytes{job=\"naijachase-api\"}","legendFormat":"RSS"}]}
  ]
}
