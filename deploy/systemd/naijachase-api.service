[Unit]
Description=NaijaChase Rust API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=drawback-admin
Group=drawback-admin
WorkingDirectory=/opt/naijachase/source
EnvironmentFile=/opt/naijachase/shared/production.env
Environment=RUST_BACKTRACE=1
ExecStart=/opt/naijachase/source/rust/target/release/naijachase-api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
